{
  "manifest_version": 3,
  "name": "AgentPet ChatGPT Web Connector",
  "version": "1.2.0",
  "description": "Observe ChatGPT Web activity locally for AgentPet.",
  "permissions": ["nativeMessaging", "tabs", "alarms"],
  "host_permissions": ["https://chatgpt.com/*"],
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*"],
    "js": ["content.js"],
    "run_at": "document_idle",
    "all_frames": false
  }],
  "background": {"service_worker": "background.js"}
}
